# ---- Core ----------------------------------------------------------------
APP_ENV=development                 # production | development | demo (demo shows synthetic [DEMO] records)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/plastic_intel
# Supabase: postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
CORS_ORIGINS=http://localhost:3000

# ---- Auth ------------------------------------------------------------------
AUTH_MODE=local                     # local | supabase
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRY_HOURS=24
# Supabase Auth (AUTH_MODE=supabase): either the legacy HS256 secret or the JWKS URL
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=                  # e.g. https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# ---- AI (optional; rules work without it) ----------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AI_CLASSIFICATION_MODE=fallback     # off | fallback (only when rules are inconclusive) | always
AI_MAX_INPUT_CHARS=12000
AI_MONTHLY_BUDGET_USD=10
OPENAI_INPUT_PRICE_PER_M=0.25       # used for cost estimates only - update if pricing changes
OPENAI_OUTPUT_PRICE_PER_M=2.00

# ---- Crawler etiquette -----------------------------------------------------
CRAWLER_USER_AGENT=PlasticIntelBot/1.0 (+contact: you@yourcompany.com)
CRAWLER_MIN_DELAY_SECONDS=3
CRAWLER_TIMEOUT_SECONDS=20
CRAWLER_MAX_PAGES_PER_SITE=8
PLAYWRIGHT_ENABLED=false            # true + `pip install playwright && playwright install chromium` for JS-heavy sites

# ---- Discovery search API (any one) ----------------------------------------
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=
SERPAPI_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# ---- Trade data --------------------------------------------------------------
CENSUS_API_KEY=                     # optional, free: https://api.census.gov/data/key_signup.html
COMTRADE_API_KEY=                   # optional, free tier: https://comtradedeveloper.un.org/
IMPORTYETI_API_KEY=
VOLZA_API_KEY=
PANJIVA_API_KEY=
TRADEDATA_PRO_API_KEY=
KOMPASS_API_KEY=

# ---- Enrichment / verification ---------------------------------------------
APOLLO_API_KEY=
ZEROBOUNCE_API_KEY=

# ---- Alerts (e.g. n8n webhook) -----------------------------------------------
ALERT_WEBHOOK_URL=
